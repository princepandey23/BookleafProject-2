# BookLeaf Environment Variables
# Copy this file to .env and fill in your values

# Server
PORT=3000

# JWT Secret (change this in production)
JWT_SECRET=bookleaf_secret_2024

# Webhook Secret (must match what Bubble/frontend sends)
WEBHOOK_SECRET=bookleaf_webhook_secret_2024

# AI API Key - REQUIRED for AI email generation
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
